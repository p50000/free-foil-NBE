-- Own project file so cabal does not inherit the fork's cabal.project.
-- `../../..` is the free-foil-NBE repo root, which provides the real
-- `free-foil-nbe` and `lambda-pi-demo` packages (the generic normaliser).
packages: . ../../..

with-compiler: ghc-9.10.3
optimization: 2

-- Same free-foil pin as the repo root (branch update/free-foil-head):
-- benchmark against upstream HEAD rather than Hackage 0.3.2. A further
-- experiment with INLINABLE/UNPACK patches on this commit (marginal, see
-- notes/perf-hypotheses.md and notes/free-foil-inlinable-unpack.patch) can be
-- reproduced by pointing packages: at a patched local checkout instead.
source-repository-package
  type: git
  location: https://github.com/fizruk/free-foil.git
  tag: 71fcfc12094ea7764602001481fbbe84339a6704
  subdir: haskell/free-foil
