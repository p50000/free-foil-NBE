cabal-version:      3.0
name:               nbe-harness
version:            0.1.0.0
synopsis:           lambda-n-ways NbE benchmark: generic free-foil NbE vs hand-written foil NbEs
build-type:         Simple

-- Benchmarks the REAL generic normaliser (`free-foil-nbe` + `lambda-pi-demo`,
-- via `LambdaPi.LambdaNWays`) against two hand-written ones, on the fork's own
-- corpus: a monomorphic NbE over the same free-foil syntax
-- (`LambdaPi.Monomorphic`), and the fork's foil NbE (`Foil.NBE`). The gaps
-- measure the cost of the generic value domain and of the generic syntax. A
-- fourth column runs the monomorphic NbE generated by `FreeFoil.NbE.TH`
-- (`LambdaPi.Codegen`).
--
-- Compiled with a modern GHC (native aarch64) because the fork's own GHC 8.10.7
-- has no native aarch64 codegen; only the fork's self-contained `Util.*` and
-- `Foil.NBE` modules are pulled in (via hs-source-dirs), not its whole build.
-- Clone the fork at ../lambda-n-ways-fork (see ../README.md).

executable nbe-harness
    main-is:          Main.hs
    hs-source-dirs:   app, ../lambda-n-ways-fork/lib
    other-modules:    Util.Syntax.Lambda
                    , Util.IdInt
                    , Util.IdInt.Set
                    , Util.Imports
                    , Util.Misc
                    , Util.Id
                    , Util.Stats
                    , Util.Impl
                    , Foil.NBE
    ghc-options:      -O2 -rtsopts
    default-extensions:
                    DataKinds
                  , DeriveGeneric
                  , DeriveTraversable
                  , EmptyCase
                  , ExistentialQuantification
                  , FlexibleContexts
                  , FlexibleInstances
                  , GADTs
                  , GeneralizedNewtypeDeriving
                  , InstanceSigs
                  , MultiParamTypeClasses
                  , PolyKinds
                  , RankNTypes
                  , ScopedTypeVariables
                  , StandaloneDeriving
                  , TupleSections
                  , TypeFamilies
                  , TypeApplications
                  , TypeOperators
                  , UndecidableInstances
    build-depends:    base
                    , containers
                    , deepseq
                    , mtl
                    , QuickCheck
                    , pretty
                    , tasty-bench
                    , free-foil
                    , free-foil-nbe
                    , free-foil-nbe:lambda-pi-demo
    default-language: Haskell2010
