cabal-version:      3.0
name:               nbe-harness
version:            0.1.0.0
synopsis:           Minimal lambda-n-ways NbE benchmark (modern GHC, native aarch64)
build-type:         Simple

-- Place this directory INSIDE a clone of the lambda-n-ways fork (i.e. at
-- <fork>/nbe-harness/) so the relative source path `../lib` and the default
-- corpus path `../lams/` resolve. It reuses the fork's real Util.* + Foil.NBE
-- source and the free-foil-NBE eager-values port (Foil.EagerNBE), compiled with
-- a modern GHC because the fork's own GHC 8.10.7 has no native aarch64 codegen
-- (it needs LLVM 9-12, unavailable on Apple Silicon). See ../nbe-harness guide.

executable nbe-harness
    main-is:          Main.hs
    hs-source-dirs:   app, ../lib
    other-modules:    Util.Syntax.Lambda
                    , Util.IdInt
                    , Util.IdInt.Set
                    , Util.Imports
                    , Util.Misc
                    , Util.Id
                    , Util.Stats
                    , Util.Impl
                    , Foil.NBE
                    , Foil.EagerNBE
    ghc-options:      -O2
    default-extensions:
                    DataKinds
                  , DeriveGeneric
                  , DeriveTraversable
                  , EmptyCase
                  , ExistentialQuantification
                  , FlexibleContexts
                  , FlexibleInstances
                  , GADTs
                  , GeneralizedNewtypeDeriving
                  , InstanceSigs
                  , MultiParamTypeClasses
                  , PolyKinds
                  , RankNTypes
                  , ScopedTypeVariables
                  , StandaloneDeriving
                  , TupleSections
                  , TypeFamilies
                  , TypeApplications
                  , TypeOperators
                  , UndecidableInstances
    build-depends:    base
                    , containers
                    , deepseq
                    , mtl
                    , QuickCheck
                    , pretty
                    , tasty-bench
    default-language: Haskell2010
