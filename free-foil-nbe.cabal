cabal-version:      3.0
name:               free-foil-nbe
version:            0.1.0.0
synopsis:           Generic normalisation by evaluation via free-foil
license:            BSD-3-Clause
license-file:       LICENSE
maintainer:         rentacat45@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  FreeFoil.NbE
    build-depends:    base ^>=4.20.2.0
        , free-foil ^>=0.5.0
        , containers ^>=0.7
    default-language: Haskell2010

-- BNFC-generated parser/printer for lambda-pi, from demo/grammar/LambdaPi/Syntax.cf.
-- Kept in its own library so -Wall does not apply to generated code.
-- Regenerate with ./grammar-regen.sh (needs bnfc, alex, happy).
library lambda-pi-syntax
    hs-source-dirs:   gen
    exposed-modules:  LambdaPi.Syntax.Abs
        , LambdaPi.Syntax.Lex
        , LambdaPi.Syntax.Par
        , LambdaPi.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The lambda-pi demo language: syntax, NbE wiring, parsing, pretty-printing.
-- Public so external harnesses (e.g. bench/lambda-n-ways/) can reuse the
-- normaliser through LambdaPi.LambdaNWays.
library lambda-pi-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  LambdaPi
        , LambdaPi.Parser
        , LambdaPi.PrettyPrint
        , LambdaPi.Raw
        , LambdaPi.LambdaNWays
        , LambdaPi.Monomorphic
        , Booleans
    other-modules:    LambdaPi.Generated
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , deepseq
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , lambda-pi-syntax
        , template-haskell
    default-language: Haskell2010

-- BNFC-generated parser/printer for lambda-let, from
-- demo/grammar/LambdaLet/Syntax.cf. Kept in its own library so -Wall does not
-- apply to generated code. Regenerate with ./grammar-regen.sh.
library lambda-let-syntax
    hs-source-dirs:   gen
    exposed-modules:  LambdaLet.Syntax.Abs
        , LambdaLet.Syntax.Lex
        , LambdaLet.Syntax.Par
        , LambdaLet.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The lambda-let demo language (zoo series, step 1: let / definitions):
-- grammar-generated syntax, one Eval instance, parsing, and example terms.
library lambda-let-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  LambdaLet
        , LambdaLet.Examples
        , LambdaLet.Parser
        , LambdaLet.Raw
    other-modules:    LambdaLet.Generated
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , lambda-let-syntax
        , template-haskell
    default-language: Haskell2010

-- Exercises the generic NbE on the lambda-pi language.
test-suite lambda-pi
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    LambdaPi.Gen
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , deepseq
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , lambda-let-demo
        , lambda-pi-demo
        , lambda-pi-syntax
        , tasty
        , tasty-hunit
        , tasty-quickcheck
        , QuickCheck
    default-language: Haskell2010

-- Microbenchmarks: NbE vs the reference normaliser on classic worst cases.
benchmark nbe-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Main.hs
    -- Optimisation comes from `optimization: 2` in cabal.project, which applies
    -- to the library (where nfNbe/nf live) as well as this driver.
    build-depends:    base ^>=4.20.2.0
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , lambda-pi-demo
        , tasty-bench
    default-language: Haskell2010
