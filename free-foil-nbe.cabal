cabal-version:      3.0
name:               free-foil-nbe
version:            0.1.0.0
synopsis:           Generic normalisation by evaluation via free-foil
description:
    Normalisation by evaluation that is generic in the signature of the object
    language, on top of free-foil. A language is a signature bifunctor and a
    binder type; it supplies its elimination rules as one @Eval@ instance and
    inherits the semantic domain, evaluation, readback and the normalisers
    @nf@ and @whnf@. Five demonstration languages, a monomorphic baseline and
    benchmarks are included.
homepage:           https://github.com/p50000/free-foil-NBE
bug-reports:        https://github.com/p50000/free-foil-NBE/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Renata Shakirova, Nikolai Kudasov
maintainer:         rentacat45@gmail.com
category:           Language
build-type:         Simple
tested-with:        GHC == 9.10.3
extra-doc-files:    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/p50000/free-foil-NBE.git

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  FreeFoil.NbE
        , FreeFoil.NbE.Conversion
        , FreeFoil.NbE.Definitions
        , FreeFoil.NbE.Glue
        , FreeFoil.NbE.Sum
    other-modules:    FreeFoil.NbE.Internal.Value
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , free-foil ^>=0.5.0
        , containers ^>=0.7
    default-language: Haskell2010

-- Parsing shared by the demo languages: a BNFC parser, then scope resolution.
library demo-parsing
    import:           warnings
    visibility:       public
    hs-source-dirs:   parsing
    exposed-modules:  Demo.Parsing
    build-depends:    base ^>=4.20.2.0
        , containers ^>=0.7
        , free-foil ^>=0.5.0
    default-language: Haskell2010

-- BNFC-generated parser/printer for lambda-pi, from demo/grammar/LambdaPi/Syntax.cf.
-- Kept in its own library so -Wall does not apply to generated code.
-- Regenerate with ./grammar-regen.sh (needs bnfc, alex, happy).
library lambda-pi-syntax
    hs-source-dirs:   gen
    exposed-modules:  LambdaPi.Syntax.Abs
        , LambdaPi.Syntax.Lex
        , LambdaPi.Syntax.Par
        , LambdaPi.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The lambda-pi demo language: syntax, NbE wiring, parsing, pretty-printing.
library lambda-pi-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  LambdaPi
        , LambdaPi.Examples
        , LambdaPi.Generated
        , LambdaPi.Parser
        , LambdaPi.PrettyPrint
        , LambdaPi.Raw
        , Booleans
        , Booleans.Examples
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , demo-parsing
        , deepseq
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , lambda-pi-syntax
        , template-haskell
    default-language: Haskell2010

library pairs-syntax
    hs-source-dirs:   gen
    exposed-modules:  Pairs.Syntax.Abs
        , Pairs.Syntax.Lex
        , Pairs.Syntax.Par
        , Pairs.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The pairs demo language: grammar-generated syntax whose one pattern binds
-- two names, one Eval instance, parsing, and example terms.
library pairs-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  Pairs
        , Pairs.Examples
        , Pairs.Parser
        , Pairs.Raw
    other-modules:    Pairs.Generated
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , demo-parsing
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , pairs-syntax
        , template-haskell
    default-language: Haskell2010

library naturals-syntax
    hs-source-dirs:   gen
    exposed-modules:  Naturals.Syntax.Abs
        , Naturals.Syntax.Lex
        , Naturals.Syntax.Par
        , Naturals.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The naturals demo language: grammar-generated syntax whose one pattern
-- binds two names, one Eval instance, parsing, and example terms.
library naturals-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  Naturals
        , Naturals.Examples
        , Naturals.Parser
        , Naturals.Raw
    other-modules:    Naturals.Generated
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , demo-parsing
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , naturals-syntax
        , template-haskell
    default-language: Haskell2010

library monolith-syntax
    hs-source-dirs:   gen
    exposed-modules:  Monolith.Syntax.Abs
        , Monolith.Syntax.Lex
        , Monolith.Syntax.Par
        , Monolith.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The monolithic language: functions, pairs and naturals in one signature,
-- written the usual way, as the baseline of the composed language, which
-- also parses and prints through it.
library monolith-baseline
    import:           warnings
    visibility:       public
    hs-source-dirs:   baselines
    exposed-modules:  Monolith
        , Monolith.Parser
        , Monolith.Raw
    other-modules:    Monolith.Generated
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , demo-parsing
        , deepseq
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , monolith-syntax
        , template-haskell
    default-language: Haskell2010

-- Languages composed from fragments: each fragment gives its rules once, a
-- language is a Sum of fragments with one pattern type, and the Eval instance
-- of the sum is the library's.
library fragments-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  Fragments.Combined
        , Fragments.Lambda
        , Fragments.Naturals
        , Fragments.Pairs
        , Fragments.Pattern
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , deepseq
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , monolith-baseline
    default-language: Haskell2010

-- Baselines for measuring the generic normaliser on lambda-pi: a monomorphic
-- NbE over the same syntax, and the bridge to the lambda-n-ways harness.
-- Public so that the harness under bench/lambda-n-ways/ can use it.
library lambda-pi-baselines
    import:           warnings
    visibility:       public
    hs-source-dirs:   baselines
    exposed-modules:  LambdaPi.LambdaNWays
        , LambdaPi.Monomorphic
    build-depends:    base ^>=4.20.2.0
        , containers ^>=0.7
        , deepseq
        , free-foil ^>=0.5.0
        , lambda-pi-demo
    default-language: Haskell2010

-- BNFC-generated parser/printer for lambda-let, from
-- demo/grammar/LambdaLet/Syntax.cf. Kept in its own library so -Wall does not
-- apply to generated code. Regenerate with ./grammar-regen.sh.
library lambda-let-syntax
    hs-source-dirs:   gen
    exposed-modules:  LambdaLet.Syntax.Abs
        , LambdaLet.Syntax.Lex
        , LambdaLet.Syntax.Par
        , LambdaLet.Syntax.Print
    build-depends:    base ^>=4.20.2.0
        , array
    default-language: Haskell2010

-- The lambda-let demo language: grammar-generated syntax, one Eval instance,
-- parsing, and example terms.
library lambda-let-demo
    import:           warnings
    visibility:       public
    hs-source-dirs:   demo
    exposed-modules:  LambdaLet
        , LambdaLet.Examples
        , LambdaLet.Parser
        , LambdaLet.Raw
    other-modules:    LambdaLet.Generated
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , demo-parsing
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , kind-generics >=0.5.0 && <0.6
        , kind-generics-th
        , lambda-let-syntax
        , template-haskell
    default-language: Haskell2010

-- Exercises the generic NbE on every demo language.
test-suite free-foil-nbe-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    Test.Agree
                    , Test.Booleans
                    , Test.Definitions
                    , Test.Fragments
                    , Test.Glue
                    , Test.LambdaLet
                    , Test.LambdaNWays
                    , Test.LambdaPi
                    , Test.LambdaPi.Gen
                    , Test.Monolith
                    , Test.Naturals
                    , Test.Pairs
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , deepseq
        , fragments-demo
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , lambda-let-demo
        , lambda-pi-baselines
        , lambda-pi-demo
        , lambda-pi-syntax
        , monolith-baseline
        , monolith-syntax
        , naturals-demo
        , naturals-syntax
        , pairs-demo
        , pairs-syntax
        , tasty
        , tasty-hunit
        , tasty-quickcheck
        , QuickCheck
    default-language: Haskell2010

-- Microbenchmarks: NbE vs the reference normaliser on classic worst cases.
benchmark nbe-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Main.hs
    -- Optimisation comes from `optimization: 2` in cabal.project, which applies
    -- to the library (where nf/nfSubst live) as well as this driver.
    build-depends:    base ^>=4.20.2.0
        , bifunctors
        , containers ^>=0.7
        , free-foil ^>=0.5.0
        , free-foil-nbe
        , fragments-demo
        , lambda-pi-baselines
        , lambda-pi-demo
        , monolith-baseline
        , tasty-bench
    default-language: Haskell2010
