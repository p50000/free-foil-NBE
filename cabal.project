packages: .

-- The project targets base 4.20 (GHC 9.10).
with-compiler: ghc-9.10.3

-- Track free-foil HEAD rather than the Hackage release: it carries the
-- merged perf series (fizruk/free-foil#87: mkFreeFoil generates CoSinkable;
-- fizruk/free-foil#88: the pattern traversals hand back the extended scope;
-- fizruk/free-foil#86: INLINABLE operations) that this code relies on. The
-- `free-foil ^>=0.3.2` bound in the cabal file still holds (HEAD is 0.3.3).
source-repository-package
  type: git
  location: https://github.com/fizruk/free-foil.git
  tag: 66bd934385604268f40f9b837a5f101f76d47c2f
  subdir: haskell/free-foil

-- Build the test suite and benchmark as part of `cabal build all` (and CI),
-- not only under `cabal test` / `cabal bench`.
tests: True
benchmarks: True

-- Optimise every component, including the library where `nfNbe`/`nf` live, so
-- the benchmark measures -O2 code end to end (cabal defaults to -O1).
optimization: 2
