packages: .

-- The project targets base 4.20 (GHC 9.10).
with-compiler: ghc-9.10.3

-- Track free-foil's git HEAD rather than the Hackage release, so that
-- upstream changes made for this project are usable as soon as they land.
-- The commit below is free-foil's main after its #117: mkFreeFoil generates
-- the bifunctor and ZipMatchK instances of its signatures, foldAST and
-- hoistAST, written-out ZipMatchK for Sum and Product, nameBinderListOf as a
-- method, nominal scope indices.
source-repository-package
  type: git
  location: https://github.com/fizruk/free-foil.git
  tag: a069d339e274dee4adf1158b70a708313dde0e85
  subdir: haskell/free-foil

-- Build the test suite and benchmark as part of `cabal build all` (and CI),
-- not only under `cabal test` / `cabal bench`.
tests: True
benchmarks: True

-- Optimise every component, including the library where `nf`/`nfSubst` live, so
-- the benchmark measures -O2 code end to end (cabal defaults to -O1).
optimization: 2
